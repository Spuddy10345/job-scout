# Copy to .env and fill in. Any source whose keys are missing is simply switched off.

# Claude - scoring, page extraction, application notes (console.anthropic.com)
ANTHROPIC_API_KEY=

# Adzuna jobs API - free, https://developer.adzuna.com/signup
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Reed jobseeker API - free, https://www.reed.co.uk/developers/jobseeker
REED_API_KEY=

# Brave Search API - web discovery + company lookup, https://api-dashboard.search.brave.com
BRAVE_API_KEY=

# Firecrawl - rendered pages for boards without APIs and JS careers pages, https://firecrawl.dev
FIRECRAWL_API_KEY=

# Home Assistant long-lived access token (Profile -> Security) for push alerts
HA_TOKEN=
