# Copy to .env and fill in what you have. Sources whose keys are missing switch themselves off.
# Any variable can instead be read from a file: set NAME_FILE=/path/to/secret (e.g. Docker secrets).
# After changing a key, restart: docker compose up -d --force-recreate

# ---- AI (needed for scoring) ------------------------------------------------------------------
# Claude - scores jobs, reads careers pages, drafts application notes. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ---- Job sources -------------------------------------------------------------------------------
# Adzuna - free key, https://developer.adzuna.com/signup
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Reed (UK) - free key, https://www.reed.co.uk/developers/jobseeker
REED_API_KEY=
# Brave Search - web discovery + company lookup; $5/month free credit, https://api-dashboard.search.brave.com
BRAVE_API_KEY=
# BRAVE_RPS=1        # requests per second to allow (raise it on paid plans)
# Firecrawl - boards without APIs and JavaScript careers pages; 1,000 free credits/month, https://firecrawl.dev
FIRECRAWL_API_KEY=

# ---- Alerts ------------------------------------------------------------------------------------
# Apprise service URLs, space or comma separated - https://github.com/caronc/apprise/wiki
# e.g. ntfy://ntfy.sh/pick-a-long-random-topic  tgram://BOT_TOKEN/CHAT_ID  discord://WEBHOOK_ID/TOKEN
APPRISE_URLS=
# Home Assistant long-lived access token (Profile -> Security) for companion-app alerts
HA_TOKEN=

# ---- Web UI ------------------------------------------------------------------------------------
# Set a password if anyone but you can reach the app (LAN, Tailscale, reverse proxy...)
JOBSCOUT_PASSWORD=
# Signs the login cookie. Optional - one is generated into the data directory if unset.
# JOBSCOUT_SECRET_KEY=
# JOBSCOUT_HTTPS_ONLY=1   # only send the login cookie over HTTPS (behind a TLS proxy)

# ---- Docker Compose ----------------------------------------------------------------------------
# JOBSCOUT_BIND=127.0.0.1   # 0.0.0.0 to reach it from other devices (set a password!)
# JOBSCOUT_HOST_PORT=8080
# TZ=Europe/London          # quiet hours, digest time and displayed times use this

# ---- Running without Docker --------------------------------------------------------------------
# JOBSCOUT_HOST=127.0.0.1
# JOBSCOUT_PORT=8080
# JOBSCOUT_DATA=./data      # database, uploaded CV and session key
# JOBSCOUT_CONFIG=config/local.yaml
# JOBSCOUT_CONTACT=you@example.com   # sent to OpenStreetMap Nominatim, as its usage policy asks
